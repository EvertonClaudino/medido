# Segredo para assinatura de JWT do Auth.js (gerar com `openssl rand -hex 32` ou crypto)
AUTH_SECRET="gerar-segredo-aleatorio-com-32-bytes-em-hex"
AUTH_URL="http://localhost:3000"
# Com o pooler do Neon (host com -pooler), manter pgbouncer=true para o Prisma não reutilizar planos em cache
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require&pgbouncer=true"

