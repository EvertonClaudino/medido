generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String               @id @default(cuid())
  name             String
  nif              String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  address          String?
  phone            String?
  budgets          Budget[]
  clientActivities ClientActivity[]
  clients          Client[]
  projects         Project[]
  tasks            Task[]
  users            User[]
  visitRequests    VisitRequest[]
  measurements     WorkLogMeasurement[]
  workLogs         WorkLog[]

  @@map("companies")
}

model User {
  id                   String              @id @default(cuid())
  companyId            String
  name                 String
  email                String              @unique
  password             String
  role                 Role                @default(WORKER)
  status               UserStatus          @default(ACTIVE)
  specialty            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  mustChangePassword   Boolean             @default(false)
  budgetRevisions      BudgetRevision[]    @relation("BudgetRevisionEditor")
  clientActivities     ClientActivity[]    @relation("ClientActivityAuthor")
  createdBudgets       Budget[]            @relation("BudgetCreator")
  assignments          ProjectAssignment[]
  assignedTasks        Task[]              @relation("TaskAssignee")
  createdTasks         Task[]              @relation("TaskCreator")
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdVisitRequests VisitRequest[]      @relation("VisitRequestCreator")
  assignedVisits       VisitRequest[]      @relation("VisitRequestAssignee")
  workLogs             WorkLog[]           @relation("WorkerLogs")
  reviews              WorkLog[]           @relation("ForemanReviews")

  @@index([companyId])
  @@map("users")
}

model Project {
  id          String              @id @default(cuid())
  companyId   String
  name        String
  code        String?
  clientName  String?
  address     String?
  budget      Decimal?            @db.Decimal(14, 2)
  status      ProjectStatus       @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  clientId    String?
  serviceType String?
  quote       Budget?
  assignments ProjectAssignment[]
  client      Client?             @relation(fields: [clientId], references: [id])
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks       Task[]
  workLogs    WorkLog[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, clientId])
  @@map("projects")
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_assignments")
}

model WorkLog {
  id              String               @id @default(cuid())
  companyId       String
  projectId       String
  hours           Decimal?             @db.Decimal(4, 2)
  description     String?
  status          WorkLogStatus        @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  authorId        String
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  workDate        DateTime             @db.Date
  measurements    WorkLogMeasurement[]
  author          User                 @relation("WorkerLogs", fields: [authorId], references: [id])
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy      User?                @relation("ForemanReviews", fields: [reviewedById], references: [id])

  @@index([companyId, projectId, status])
  @@index([companyId, authorId, workDate])
  @@map("work_logs")
}

model WorkLogMeasurement {
  id          String      @id @default(cuid())
  companyId   String
  workLogId   String
  description String
  quantity    Decimal     @db.Decimal(12, 3)
  unit        MeasureUnit
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workLog     WorkLog     @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  @@index([companyId, workLogId])
  @@map("work_log_measurements")
}

model Task {
  id           String     @id @default(cuid())
  companyId    String
  projectId    String?
  createdById  String
  assignedToId String
  title        String
  description  String?
  dueDate      DateTime?
  status       TaskStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedTo   User       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("TaskCreator", fields: [createdById], references: [id])
  project      Project?   @relation(fields: [projectId], references: [id])

  @@index([companyId, assignedToId, status])
  @@index([companyId, dueDate])
  @@index([companyId, projectId])
  @@map("tasks")
}

model Client {
  id            String           @id @default(cuid())
  companyId     String
  name          String
  nif           String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  activities    ClientActivity[]
  budgets       Budget[]
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects      Project[]
  visitRequests VisitRequest[]

  @@index([companyId])
  @@map("clients")
}

model VisitRequest {
  id               String      @id @default(cuid())
  companyId        String
  clientId         String
  requestedAddress String
  scheduledAt      DateTime?
  /// Duração prevista da visita, usada na agenda do responsável
  durationMinutes  Int         @default(60)
  status           VisitStatus @default(REQUESTED)
  notes            String?
  createdById      String
  /// Encarregado (ou Dono) que realiza a visita
  assignedToId     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  budget           Budget?
  client           Client      @relation(fields: [clientId], references: [id])
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy        User        @relation("VisitRequestCreator", fields: [createdById], references: [id])
  assignedTo       User?       @relation("VisitRequestAssignee", fields: [assignedToId], references: [id])

  @@index([companyId, status, createdAt])
  @@index([companyId, clientId])
  @@index([companyId, assignedToId, scheduledAt])
  @@map("visit_requests")
}

model Budget {
  id             String           @id @default(cuid())
  companyId      String
  clientId       String
  visitRequestId String?          @unique
  projectId      String?          @unique
  projectName    String
  workAddress    String
  notes          String?
  status         BudgetStatus     @default(DRAFT)
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          BudgetItem[]
  revisions      BudgetRevision[]
  client         Client           @relation(fields: [clientId], references: [id])
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("BudgetCreator", fields: [createdById], references: [id])
  project        Project?         @relation(fields: [projectId], references: [id])
  visitRequest   VisitRequest?    @relation(fields: [visitRequestId], references: [id])

  @@index([companyId, status, updatedAt])
  @@index([companyId, clientId])
  @@map("budgets")
}

model BudgetItem {
  id          String  @id @default(cuid())
  budgetId    String
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit        String
  unitPrice   Decimal @db.Decimal(14, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  position    Int
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, position])
  @@map("budget_items")
}

model BudgetRevision {
  id             String             @id @default(cuid())
  budgetId       String
  revisionNumber Int
  type           BudgetRevisionType
  snapshot       Json
  editorId       String
  createdAt      DateTime           @default(now())
  budget         Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  editor         User               @relation("BudgetRevisionEditor", fields: [editorId], references: [id])

  @@unique([budgetId, revisionNumber])
  @@index([budgetId, createdAt])
  @@map("budget_revisions")
}

/// Interação registada com um cliente (chamada, email, reunião ou nota)
model ClientActivity {
  id          String             @id @default(cuid())
  companyId   String
  clientId    String
  authorId    String
  type        ClientActivityType
  description String
  occurredAt  DateTime
  createdAt   DateTime           @default(now())
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author      User               @relation("ClientActivityAuthor", fields: [authorId], references: [id])

  @@index([companyId, clientId, occurredAt])
  @@map("client_activities")
}

/// Tentativas falhadas de início de sessão por chave ("email:<email>" ou "ip:<ip>")
model LoginAttempt {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
  @@map("login_attempts")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  createdAt DateTime @default(now())

  @@map("leads")
}

enum Role {
  OWNER
  FOREMAN
  WORKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum WorkLogStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum VisitStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  SENT
  NEGOTIATION
  APPROVED
  REJECTED
  CANCELLED
}

enum BudgetRevisionType {
  CREATED
  CONTENT_EDIT
  STATUS_CHANGE
}

enum ClientActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum MeasureUnit {
  M
  M2
  M3
  UN
  KG
}
